{
  "app": {
    "windows": [
      {
        "title": "tauri-react-template",
        "width": 1200,
        "height": 800,
        "minWidth": 375,
        "minHeight": 600,
        "center": true,
        "transparent": true,
        "decorations": false,
        "disableInputAccessoryView": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'"
    }
  },
  "bundle": {
    "publisher": "YanX Studio",
    "homepage": "https://github.com/YanxReal/tauri-react-template",
    "windows": {
      "allowDowngrades": true,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "startMenuFolder": "tauri-react-template",
        "installMode": "currentUser",
        "languages": ["English", "Spanish", "SpanishInternational"],
        "displayLanguageSelector": true,
        "compression": "lzma"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
