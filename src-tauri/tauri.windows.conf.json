{
  "app": {
    "windows": [
      {
        "title": "Tauri-react-template",
        "width": 1200,
        "height": 800,
        "minWidth": 375,
        "minHeight": 600,
        "center": true,
        "transparent": true,
        "decorations": false,
        "scrollBarStyle": "fluentOverlay",
        "disableInputAccessoryView": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "publisher": "YanX Studio",
    "homepage": "https://github.com/YanxReal/Tauri-react-template",
    "copyright": "Copyright © 2026 YanX Studio",
    "category": "DeveloperTool",
    "licenseFile": "LICENSE.rtf",
    "windows": {
      "allowDowngrades": true,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "startMenuFolder": "Tauri-react-template",
        "installMode": "currentUser",
        "languages": ["English", "Spanish", "SpanishInternational"],
        "displayLanguageSelector": true,
        "compression": "lzma",
        "installerHooks": "hooks/installer.nsh"
      },
      "wix": {
        "language": "en-US",
        "bannerPath": "icons/wix-banner.bmp",
        "dialogImagePath": "icons/wix-dialog.bmp"
      }
    }
  }
}
