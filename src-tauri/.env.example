# Public env vars embedded at build time via src-tauri/build.rs.
# Copy to src-tauri/.env (gitignored) or export in your shell/CI.
# The template compiles without this file (uses defaults); in release, SUPABASE_URL must be https://*.supabase.co if you use it.

# Generic example
VITE_API_URL=http://localhost:1420
# Optional Supabase (if you use a Supabase backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
