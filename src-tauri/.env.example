# Public env vars embedded at build time via src-tauri/build.rs (mirrors Prestly).
# Copia a src-tauri/.env (gitignored) o exporta en tu shell/CI.
# El template compila sin este archivo (usa defaults); en release, SUPABASE_URL debe ser https://*.supabase.co si lo usas.

# Ejemplo genérico
VITE_API_URL=http://localhost:43422
# Supabase opcional (si usas Prestly-style backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
