// {{app.name}}_Apple — per-SDK adaptation layer for the unified Apple target.
//
// ONE Xcode target builds BOTH destinations (iOS + macOS). Everything
// that differs between them lives behind these [sdk=...] conditionals;
// the Rust side stays symmetric (main.mm -> ffi::start_app() -> libapp.a).

// Both platforms are valid destinations of the single target.
//
// Do NOT add SUPPORTED_DESTINATIONS here: it acts as a WHITELIST and
// hides every concrete device/simulator from Xcode's destination bar
// (only a generic "+" add-entry remains). Destinations are DERIVED
// correctly from SUPPORTED_PLATFORMS + TARGETED_DEVICE_FAMILY below —
// verified showing Any Mac (+ "Designed for [iPad,iPhone]"), the physical
// iPhone, every iPhone/iPad simulator.
SUPPORTED_PLATFORMS = macosx iphoneos iphonesimulator

// iPhone (1) + iPad (2). There is no separate "iPad platform": iPad is a
// device family of platform=iOS, so this setting is what makes iPad a
// first-class destination (including macOS "Designed for iPad").
// xcconfig GOTCHA: NO quotes around 1,2 — quotes become part of the value
// and Xcode then fails to match ANY device family (iPhones went
// "incompatible").
TARGETED_DEVICE_FAMILY = 1,2

// The macOS shell is host-native; 15.0 covers every tao/wry API in use.
MACOSX_DEPLOYMENT_TARGET = 15.0

// The Rust core links as a static library (-lapp) on BOTH platforms —
// only the slice directory differs: arch-split on iOS, host-native on
// macOS (Externals/macosx/<config>, produced by "Build Rust Code").
OTHER_LDFLAGS = $(inherited) -lapp
LIBRARY_SEARCH_PATHS[sdk=macosx*] = $(inherited) $(PROJECT_DIR)/Externals/macosx/$(CONFIGURATION)

// Per-platform entitlements (static files next to Info.plist). The macOS
// side carries the App Sandbox required for Mac App Store distribution.
CODE_SIGN_ENTITLEMENTS[sdk=iphone*] = {{app.name}}_Apple/ios.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = {{app.name}}_Apple/macos.entitlements

// Framework surface. WebKit/Metal/CoreGraphics/QuartzCore/Security exist
// on both; UIKit is iOS-only and AppKit replaces it on macOS (tao/wry
// window glue). Carbon supplies tao's keyboard-layout APIs (TIS*/LM*)
// that plain-cargo desktop builds get via cargo's own link flags.
OTHER_LDFLAGS[sdk=iphone*] = $(inherited) -framework UIKit -framework MetalKit -framework CoreGraphics -framework Metal -framework QuartzCore -framework Security -framework WebKit
OTHER_LDFLAGS[sdk=macosx*] = $(inherited) -framework AppKit -framework MetalKit -framework CoreGraphics -framework Metal -framework QuartzCore -framework Security -framework WebKit -framework Carbon -framework OSAKit

// iOS-only resources do not exist on the Mac side.
EXCLUDED_SOURCE_FILE_NAMES[sdk=macosx*] = LaunchScreen.storyboard
