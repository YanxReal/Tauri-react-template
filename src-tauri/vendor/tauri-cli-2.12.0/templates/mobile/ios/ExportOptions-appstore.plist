<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store distribution: archive with Xcode (Product > Archive on
         the prestly_Apple scheme, destination My Mac), then
         xcodebuild -exportArchive -exportOptionsPlist THIS_FILE.
         Requires: Apple Distribution certificate + a "Mac App Store Connect"
         provisioning profile for com.yanxstudio.prestly (create it in the
          developer portal and set its name below). -->
    <key>method</key>
    <string>app-store-connect</string>
    <key>teamID</key>
    <string>36ZZP8X3F5</string>
    <key>signingCertificate</key>
    <string>Apple Distribution</string>
    <!-- Uncomment and fill after creating the MAS provisioning profile:
    <key>provisioningProfiles</key>
    <dict>
        <key>com.yanxstudio.prestly</key>
        <string>Mac App Store Connect — Prestly</string>
    </dict>
    -->
</dict>
</plist>
